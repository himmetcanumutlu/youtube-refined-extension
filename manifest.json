{
  "manifest_version": 3,
  "name": "YT Refined",
  "short_name": "Refined",
  "version": "1.6.4",
  "description": "Purify your YouTube experience. Auto HD, SponsorBlock, PIP, Focus Mode, and Advanced Media Controls.",
  "permissions": ["storage"],
  "host_permissions": ["*://www.youtube.com/*", "https://returnyoutubedislikeapi.com/*", "https://sponsor.ajay.app/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Settings"
  },
  "content_scripts": [
    {
      "matches": ["*://www.youtube.com/*"],
      "js": ["inject.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["*://www.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ]
}
