{
  "manifest_version": 3,
  "name": "YT Refined",
  "short_name": "Refined",
  "version": "1.6.1",
  "description": "Purify your YouTube experience. Auto HD, SponsorBlock, PIP, Focus Mode, and Advanced Media Controls.",
  "permissions": ["activeTab", "storage"],
  "host_permissions": ["*://*.youtube.com/*", "https://returnyoutubedislikeapi.com/*", "https://sponsor.ajay.app/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Settings"
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["inject.js"],
      "matches": ["*://*.youtube.com/*"]
    }
  ]
}